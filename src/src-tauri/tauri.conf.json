{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PLC调试上位机",
  "version": "0.1.0",
  "identifier": "com.ldr.plc-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PLC 调试上位机",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
