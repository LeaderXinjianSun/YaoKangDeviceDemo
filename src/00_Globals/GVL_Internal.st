(*============================================================================
  内部全局变量（不映射 D 区，层间通信）
  ----------------------------------------------------------------------------
  单写源硬约束（见开发计划 §0.4）：
    iState / iWorkMode ......... MODE_MANAGER 唯一写
    Error / Warning / Queue .... ERROR_MANAGER 唯一写
    轴 bEnable / MC 指令 ....... POWER / OUTPUT_ADAPTER 唯一写
    任务级请求 ................. 各任务模块经 gTrig* / FaultReq 提交
==========================================================================*)
VAR_GLOBAL
    (*--- 系统状态（MODE_MANAGER 单写） ---*)
    iState          : INT := 0;        (* 主状态码，见 GVL_CONST：ST_* *)
    iPhase          : INT := 0;        (* 当前任务内阶段（任务模块上报） *)
    iBlockReason    : INT := 0;        (* 阻塞原因码 *)
    iWorkMode       : INT := 0;        (* 工作模式 1=调理 2=治疗 3=老化 *)
    iUserRole       : INT := 0;        (* 角色镜像（HMI 线协议：0=操作员 1=工程师） *)

    (*--- 安全（SAFETY_MANAGER 单写） ---*)
    bHardEstop      : BOOL;            (* 硬急停：断使能（物理链断开 或 锁存升级） *)
    bSoftEstop      : BOOL;            (* 软急停：受控减速 *)
    bSafetyStop     : BOOL;            (* 安全链触发的停止请求（硬/软/保护停机任一） *)
    bProtStop       : BOOL;            (* 保护停机锁存（超力/致命保护，受控减速后锁死，需手动复位） *)
    bHardEstopLatch : BOOL;            (* 硬急停锁存（软急停超时升级；物理链恢复+复位才解除） *)
    bAllAxesIdle    : BOOL;            (* 全轴静止 *)
    bAllAxesRef     : BOOL;            (* 全轴参考有效 *)
    bAllAxesAtInit  : BOOL;            (* 全轴在初始位 *)

    (*--- I/O 镜像（INPUT_ADAPTER 单写，去抖后） ---*)
    ioEstopOK       : BOOL;            (* 急停链路正常（双通道常闭闭合 + 安全继电器未动作） *)
    ioEstop1        : BOOL;            (* 急停通道1 去抖态（X2 常闭，TRUE=闭合正常） *)
    ioEstop2        : BOOL;            (* 急停通道2 去抖态（X3 常闭，TRUE=闭合正常） *)
    ioResetBtn      : BOOL;            (* 复位按钮（X7 去抖） *)
    ioPusherOrigin  : BOOL;            (* 推杆原点（X5 去抖） *)

    (*--- 推杆位置反馈镜像（INPUT_ADAPTER 单写） ---*)
    (* 真实推杆为开关型电推杆，无 AD：位置由 HC_Counter 高速计数器读得，单位 mm；
       角度由 FB_PusherControl 用 GVL_CONST 几何常量（垂直/平行/倾斜偏置/固定角/补偿）
       经余弦定理/ACOS 解算。 *)
    rPusherPosMm    : REAL;            (* 当前推杆位置（mm，HC_Counter.Position） *)
    bPusherPosValid : BOOL;            (* 位置有效（HC_Counter.Valid，无 Error） *)

    (*--- 命令脉冲位（INPUT_ADAPTER 单写，本扫有效） ---*)
    (* H5U 全局变量不支持功能块实例：R_TRIG 在 PRG_InputAdapter 局部 VAR 声明，
       其 .Q 每扫写入下列 BOOL 位；下游直接读位，边沿仅存活一个扫描周期。 *)
    trigStart       : BOOL;            (* S1 启动流程（本扫脉冲） *)
    trigChengJiao   : BOOL;            (* S2 开始成角（本扫脉冲） *)
    trigAllow       : BOOL;            (* S3 确认（本扫脉冲） *)
    trigStop        : BOOL;            (* 停止（本扫脉冲） *)
    trigReset       : BOOL;            (* 复位错误（本扫脉冲） *)
    trigSkipAngle   : BOOL;            (* 跳过成角（本扫脉冲） *)
    (* 电平命令（直接镜像，下游读 .Q 无意义，读电平位） *)
    bPauseLevel     : BOOL;            (* 暂停（电平，Condition.Cmd 或 Sys.Cmd 任一按下） *)
    bResumeLevel    : BOOL;            (* 恢复（电平，Condition.Cmd 或 Sys.Cmd 任一按下） *)
    bFootSignal     : BOOL;            (* 脚踏（电平/脉冲按模式） *)

    (*--- 系统 Sys.Cmd 脉冲请求位（INPUT_ADAPTER 单写，本扫有效） ---*)
    trigServiceMode     : BOOL;        (* 进入维护模式请求 *)
    trigSysHoming       : BOOL;        (* 回零请求 *)
    trigSysStop         : BOOL;        (* 停止请求 *)
    trigAutoStart       : BOOL;        (* 自动流程启动 *)
    trigCalibrate       : BOOL;        (* 推杆标定流程 *)
    trigSysReset        : BOOL;        (* 复位请求（状态机复位/错误复位） *)
    trigAckError        : BOOL;        (* 确认错误 *)
    trigEmgStop         : BOOL;        (* 软急停请求（D488.9，无条件穿透） *)
    trigInitialize      : BOOL;        (* 初始化请求 *)
    trigSvcMechHome     : BOOL;        (* 维护机械回零 *)
    trigSelfTestConfirm : BOOL;        (* 自检安全确认 *)
    trigSelfTestSkip    : BOOL;        (* 自检跳过步 *)
    trigAllPowerOff     : BOOL;        (* 全轴断电 *)
    trigAllPowerOn      : BOOL;        (* 全轴上电 *)
    trigStartSelfTest   : BOOL;        (* 启动自检 *)
    trigServiceDone     : BOOL;        (* 维护完成 *)
    trigReadyCheck      : BOOL;        (* 就绪检查请求 *)
    trigQuickStart      : BOOL;        (* 快速启动（需资格位） *)
    trigForceSkipST     : BOOL;        (* 强制跳过自检（需资格位） *)
    trigClearZeroRetain : BOOL;        (* 清除建零 Retain（6 重门控） *)
    trigLearnBias       : BOOL;        (* 学习冲击轴扭矩基线 *)

    (*--- 系统电平命令镜像（按住有效，离态自动回落） ---*)
    bServiceAuthConfirm : BOOL;        (* 维护授权确认（电平，建零门控） *)
    bNoLoadConfirm      : BOOL;        (* 无负载确认（电平，建零门控） *)
    bRevalidateParams   : BOOL;        (* 参数重校验（电平，P5 消费） *)

    (*--- 三轴命令：[1..3]=Chest冲击/Seat扭角/Leg转角（与 HMI 块轴 ID 对齐，
          见 GVL_CONST AXIS_ID_*）；第二维见 AXCMD_* 索引。INPUT_ADAPTER 单写。 ---*)
    axisPulse       : BOOL[1..3, 1..8];   (* 脉冲命令位（AXCMD_RESET..AXCMD_REQ_DISABLE） *)
    axisEnableReq   : BOOL[1..3];         (* bEnable 电平：请求伺服上电（POWER 消费） *)
    axisJogPos      : BOOL[1..3];         (* bJogPos 正向点动（电平，按住有效） *)
    axisJogNeg      : BOOL[1..3];         (* bJogNeg 负向点动（电平，按住有效） *)
    axisPowerEnable : BOOL[1..3];         (* 伺服使能电平：POWER 单写（分时上电/急停切断），OUTPUT_ADAPTER 只读 *)

    (*--- 电推杆（尾板 TailTilt）命令：INPUT_ADAPTER 单写 ---*)
    trigPushStop        : BOOL;        (* 推杆停止（脉冲） *)
    trigPushReset       : BOOL;        (* 推杆复位（脉冲） *)
    trigPushCalibrate   : BOOL;        (* 推杆标定（脉冲） *)
    trigPushAutoMove    : BOOL;        (* 推杆自动定位（脉冲） *)
    trigPushHome        : BOOL;        (* 推杆回零（脉冲） *)
    trigPushPreset      : BOOL;        (* 推杆手动清零 Preset（脉冲） *)
    trigPushResetError  : BOOL;        (* 推杆清故障（脉冲） *)
    pushEnableReq       : BOOL;        (* 推杆使能（电平） *)
    jogPushUp           : BOOL;        (* 推杆正向上行点动（电平，按住有效） *)
    jogPushDown         : BOOL;        (* 推杆反向下行点动（电平，按住有效） *)

    (*--- P9 建零/标定 Retain 跨环握手（锁存位，不入 CmdPreclear 清扫表） ---*)
    (* TASK_RUNNER 环7 建零成功置 bZeroCommSetReq[i]；PARAM_SERVICE 环8 当扫消费
       写 retainZeroComm[i]:=TRUE 并清请求。推杆标定：fbPusher.bCalibDone 环10 产生，
       OUTPUT_ADAPTER 置 bPushCalibDoneLatch，PARAM_SERVICE 次扫环8 消费写
       retainTailZeroComm:=TRUE 并清。trigClearZeroRetain 环2 脉冲由 PARAM_SERVICE
       环8 消费清全部建零 Retain。 *)
    bZeroCommSetReq     : BOOL[1..3];     (* 三轴建零置位请求（锁存） *)
    bPushCalibDoneLatch : BOOL;           (* 推杆标定完成锁存（跨环） *)

    (*--- 故障提交区（任务模块写 gFaultSubmit，ERROR_MANAGER 唯一消费） ---*)
    gFaultSubmit    : BOOL;            (* 提交脉冲：填好下列字段后置 TRUE *)
    gFaultLevel     : INT;             (* 0=L0 Info 1=L1 Warning 2=L2 Critical *)
    gFaultCode      : INT;             (* 错误码（见 GVL_CONST 段位约定） *)
    gFaultSource    : INT;             (* 来源模块码 *)
    gFaultSubCode   : INT;             (* 子码：轴 9xxx / 驱动器 Er.xxx *)
    gFaultVal1      : INT;             (* 附加值 1 *)
    gFaultVal2      : INT;             (* 附加值 2 *)

    (*--- 扫描监控 ---*)
    (* 看门狗为 BOOL（H5U 内联 TONR 的 Q=> 输出），上移为全局 mnTScanWatchdog（见下方 PRG_Main 分组） *)
    diScanCount     : DINT;            (* 扫描计数（心跳） *)

    (*--- 运行统计累计器（P11，HmiOutput 写入 Sys.Runtime；非保持，上电清零） ---*)
    diStatAgingCycles : DINT;          (* 老化循环累计（老化批完成 +目标循环数） *)
    diStatTotalCycles : DINT;          (* 总循环累计（任一模式每完成 16 段循环表 +1） *)
    diStatRunTime     : DINT;          (* 自动流程累计运行时长（ms；暂停不计时） *)

    (*========================================================================
      POU 私有工作变量（H5U 编辑器不允许 PRG/FC 声明局部简单变量，
      故全部上移为全局；按所属 POU 加前缀分组，仅该 POU 读写。
      功能块实例 / TRIG.R_TRIG 边沿实例仍保留在各 POU 局部 VAR。）
      ========================================================================*)

    (*--- PRG_CmdPreclear（环1 命令清扫） ---*)
    cpIAxis  : INT;                    (* 轴清扫循环下标 1..3 *)
    cpICmd   : INT;                    (* 轴脉冲位循环下标 1..AXCMD_MAX *)

    (*--- PRG_InputAdapter（环2 输入适配） ---*)
    iaTEstop1Db    : BOOL;             (* 急停通道1 去抖输出（X2 常闭，内联 TONR Q=>） *)
    iaTEstop2Db    : BOOL;             (* 急停通道2 去抖输出（X3 常闭） *)
    iaTSafeRelayDb : BOOL;             (* 安全继电器去抖输出（X4 常开） *)
    iaTOriginDb    : BOOL;             (* 推杆原点传感器去抖输出（X5） *)
    iaTResetDb     : BOOL;             (* 复位按钮去抖输出（X7） *)
    iaTDbTime      : TIME := T#30MS;   (* 去抖时间常数（内联 TONR PT） *)
    iaDiHscPos     : DINT;             (* HC_Counter.Position 原始位置（mm，DINT） *)
    iaBHscValid    : BOOL;             (* HC_Counter.Valid *)
    iaBHscError    : BOOL;             (* HC_Counter.Error *)
    iaWHscErrId    : WORD;             (* HC_Counter.ErrorID *)

    (*--- PRG_ErrorManager（环4 故障管理） ---*)
    emIPos     : INT;                  (* 队列游标（兼容保留） *)
    emTWarnAge : BOOL;                 (* 警告存活计时（内联 TONR Q=>） *)

    (*--- PRG_ModeManager（环5 模式管理） ---*)
    mmBEngineer : BOOL;                (* 工程师门：角色=工程师 且 权限码=16#5A *)
    mmBReadyAll : BOOL;                (* 六项资格全具备 *)
    mmDiMask    : DINT;                (* 资格掩码（位置位=缺项） *)
    mmIWarnDv   : INT;                 (* 就绪不齐 Warning 提交节流（扫计数） *)

    (*--- PRG_SafetyManager（环6 安全管理） ---*)
    smTMismatch      : BOOL;           (* 双通道不一致去抖（Q=>） *)
    smBSoftStopActive: BOOL;           (* 软急停减速停车电平（停稳滑行后自动解除） *)
    smDiSoftDecelCnt : DINT;           (* 停车电平有效但轴未全静止计数（×10ms，≥500 升级硬急停） *)
    smDiCoastCnt     : DINT;           (* 软急停停稳后滑行计数（达 diEmergencyCoastMs 解除） *)
    smBHardPhysical  : BOOL;           (* 物理硬急停态（去抖，排除锁存升级） *)
    smBChanMismatch  : BOOL;           (* 急停双通道不一致（去抖前） *)
    smBAnyEncoderFlt : BOOL;           (* 任一轴编码器故障 *)
    smBAnyHwLimit    : BOOL;           (* 任一轴硬限位触发 *)
    smBAnyOverForce  : BOOL;           (* 任一轴超力锁存/实时超力 *)

    (*--- PRG_ParamService（环8 参数服务） ---*)
    psIMac0  : INT;                    (* MAC 承接第1字节（_Ethernet.MACAddress 为 USINT，截低 8 位） *)
    psIMac1  : INT;                    (* MAC 承接第2字节 *)
    psIMac2  : INT;                    (* MAC 承接第3字节 *)
    psBVC    : BOOL;                   (* 校验通过（FC_ValidateParams 输出承接） *)
    psIVCode : INT;                    (* 校验错误码 *)
    psIVAxis : INT;                    (* 错误轴 *)
    psIVField: INT;                    (* 错误字段 *)
    psI      : INT;                    (* 通用循环索引 *)

    (*--- PRG_TaskRunner（环7 任务运行） ---*)
    trIPrevState    : INT;             (* 上扫 iState（进入沿判定） *)
    trBStateEntry   : BOOL;            (* 本扫为新状态首扫 *)
    trIStepHom      : INT;             (* 普通回零步（HOMSEQ_*） *)
    trIStepEmh      : INT;             (* 紧急回零步（EMH_*） *)
    trIStepSt       : INT;             (* 自检步（ST_GATE..ST_STEP_FAIL） *)
    trIStepCal      : INT;             (* 建零步（CAL_*） *)
    trDiSnap        : DINT;            (* 任务级起始扫描快照（超时判定） *)
    trIAxis         : INT;             (* 当前活动轴下标 1..3 *)
    trBAxisDone     : BOOL[1..3];      (* 各轴任务完成（到位+静止+在初始位） *)
    trRInit         : REAL[1..3];      (* 各轴初始位镜像（runAxis[i].rInitPos） *)
    trRJogV         : REAL[1..3];      (* 各轴 Jog 主速镜像（runHoming） *)
    trRCrawlV       : REAL[1..3];      (* 各轴爬行速镜像 *)
    trRApproach     : REAL[1..3];      (* 各轴接近区镜像 *)
    trRHyst         : REAL[1..3];      (* 各轴到位迟滞镜像 *)
    trIRetry        : INT[1..3];       (* 各轴防夹重试计数 *)
    trIEmhAxis      : INT;             (* 紧急回零活动轴下标 1..3 *)
    trDiPinchSnap   : DINT;            (* 防夹撤力等待快照 *)
    trBDirtyAxis    : BOOL;            (* 脏1：三轴活动故障 *)
    trBDirtyForce   : BOOL;            (* 脏2：超力锁存/保护停机 *)
    trBDirtyPusher  : BOOL;            (* 脏3：推杆传感器异常 *)
    trBDirtyParam   : BOOL;            (* 脏4：参数需重校验 *)
    trIStAxis       : INT;             (* 自检摆动当前轴 1..3 *)
    trIStPhase      : INT;             (* 单轴摆动相位 0=+2° 1=-2° 2=归位 *)
    trDiStSnap      : DINT;            (* 自检单段快照 *)
    trDiStGlobalSnap: DINT;            (* 自检全局快照 *)
    trDiPushSnap    : DINT;            (* 推杆校准/成角快照 *)
    trBSelfTestSkipped: BOOL;          (* 本次自检经跳过/强跳完成 *)
    trDiCalSnap     : DINT;            (* 建零命令发出快照（Retain 回读超时） *)
    trBFaultLat     : BOOL;            (* 有未消费故障锁存 *)
    trBFaultSent    : BOOL;            (* 锁存故障已装填 gFaultSubmit *)
    trILatSentCode  : INT;             (* 已提交的故障码（锁存期换码则重发） *)
    trILatLevel     : INT;             (* 锁存故障级别 *)
    trILatCode      : INT;             (* 锁存故障码 *)
    trILatSource    : INT;             (* 锁存故障源 *)
    trILatSub       : INT;             (* 锁存故障子码 *)
    trBEmhPinch     : BOOL;            (* 活动轴净扭矩超阈（防夹） *)
    trBEmhAtInit    : BOOL;            (* 活动轴进入到位迟滞窗口 *)
    trIStepCond     : INT;             (* 调理步号 105..900（CONDSEQ_*） *)
    trIStepStop     : INT;             (* 停止降落步号 6000/6010（STOPSEQ_*） *)
    trICondCycle    : INT;             (* 当前循环计数（1 起） *)
    trICondTarget   : INT;             (* 目标循环数（runCond.iCycleCount） *)
    trDiCondBatch   : DINT;            (* 当前批次（1 起，老化） *)
    trDiCondSnap    : DINT;            (* 单批起始快照（总超时判定） *)
    trDiBatchSnap   : DINT;            (* 批间等待快照 *)
    trDiConfirmSnap : DINT;            (* 108/120 等待确认快照 *)
    trDiCondDoneSnap: DINT;            (* 三轴完成去抖快照 *)
    trBCondPaused   : BOOL;            (* 130 暂停态 *)
    trBAgingAuto    : BOOL;            (* 本任务为老化（WORKMODE_AGING 快照） *)
    trBAutoSignal   : BOOL;            (* 老化内部自动信号位 *)
    trBCondAngleSkip: BOOL;            (* 本批跳过成角（trigSkipAngle） *)
    trBCondCnfTout  : BOOL;            (* 确认超时 7007 已上报 *)
    trBCondRunStart : BOOL;            (* 130 循环启动锁存 *)

    (*--- PRG_OutputAdapter（环10 输出适配） ---*)
    oaISel : INT;                      (* 本扫选中的故障源（0=无 1..3=轴 4=推杆） *)

    (*--- PRG_Power（环9 上电时序） ---*)
    pwIPwrStep  : INT := 0;            (* 0=全断 1=Chest使能 2=Chest等间隔 3=Seat使能 4=Seat等间隔 5=Leg使能 6=全上电完成 *)
    pwBPwrReq   : BOOL;                (* 上电请求锁存 *)
    pwDiStepSnap: DINT;                (* 当前步进入扫描计数 *)
    pwBDisReq   : BOOL[1..3];          (* 单轴断使能请求锁存（AXCMD_REQ_DISABLE 脉冲） *)

    (*--- PRG_Main（主循环/看门狗） ---*)
    mnTScanWatchdog : BOOL;            (* 扫描看门狗超时标志（预留：待绑定 H5U 任务看门狗系统变量；置位时 SAFETY_MANAGER 上报 1007；无应用内 TONR 驱动，详见 PRG_Main 注释） *)

    (*--- FC_ValidateParams（参数校验函数，函数内私有工作变量） ---*)
    vpI   : INT;                       (* 段索引 1..16（FOR 循环） *)
    vpCfg : Stru_AxisLimitConfig;      (* 轴 Config 校验用局部视图 *)
END_VAR
